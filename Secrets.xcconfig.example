// Secrets.xcconfig のテンプレートです。
// このファイルをコピーして同じ階層に "Secrets.xcconfig" という名前で保存し、
// 下記の値を Google Cloud Console で発行した実際の OAuth クライアント ID に置き換えてください。
// Secrets.xcconfig 自体は .gitignore 対象のためコミットされません。

GID_CLIENT_ID = REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
// クライアントIDの前後を反転させた文字列(例: com.googleusercontent.apps.1234567890-abcde)。OAuth リダイレクトの URL スキームに使う。
GID_REVERSED_CLIENT_ID = com.googleusercontent.apps.REPLACE_WITH_REVERSED_CLIENT_ID
